{
  "additionalProperties": false,
  "type": "object",
  "required": ["protocol", "protocolVersion", "runId", "seq", "type", "sentAt", "payload"],
  "properties": {
    "protocol": {
      "const": "performance-kit",
      "type": "string"
    },
    "protocolVersion": {
      "const": 1,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "type": "string"
    },
    "seq": {
      "minimum": 0,
      "type": "integer"
    },
    "type": {
      "const": "runEnd",
      "type": "string"
    },
    "sentAt": {
      "minimum": 0,
      "type": "number"
    },
    "payload": {
      "additionalProperties": false,
      "type": "object",
      "required": ["runEnd", "frames", "blocks", "watchdogTicks", "phases", "ready", "downloads", "environment"],
      "properties": {
        "navigationStart": {
          "minimum": 0,
          "type": "number"
        },
        "runStart": {
          "minimum": 0,
          "type": "number"
        },
        "renderStart": {
          "minimum": 0,
          "type": "number"
        },
        "runEnd": {
          "minimum": 0,
          "type": "number"
        },
        "throughput": {
          "additionalProperties": false,
          "type": "object",
          "required": ["completedFrames", "elapsed"],
          "properties": {
            "completedFrames": {
              "minimum": 0,
              "type": "integer"
            },
            "elapsed": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          }
        },
        "frames": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["cpuStart", "cpuEnd"],
            "properties": {
              "cpuStart": {
                "minimum": 0,
                "type": "number"
              },
              "cpuEnd": {
                "minimum": 0,
                "type": "number"
              },
              "presented": {
                "minimum": 0,
                "type": "number"
              },
              "gpuStart": {
                "pattern": "^[0-9]+$",
                "type": "string"
              },
              "gpuEnd": {
                "pattern": "^[0-9]+$",
                "type": "string"
              },
              "animationTime": {
                "type": "number"
              }
            }
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["start", "end", "source"],
            "properties": {
              "start": {
                "minimum": 0,
                "type": "number"
              },
              "end": {
                "minimum": 0,
                "type": "number"
              },
              "scripts": {
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": ["start", "end"],
                  "properties": {
                    "start": {
                      "minimum": 0,
                      "type": "number"
                    },
                    "end": {
                      "minimum": 0,
                      "type": "number"
                    },
                    "sourceURL": {
                      "type": "string"
                    },
                    "invoker": {
                      "type": "string"
                    },
                    "invokerType": {
                      "type": "string"
                    },
                    "sourceFunctionName": {
                      "type": "string"
                    },
                    "sourceCharPosition": {
                      "type": "number"
                    }
                  }
                }
              },
              "source": {
                "anyOf": [
                  {
                    "const": "longtask",
                    "type": "string"
                  },
                  {
                    "const": "loaf",
                    "type": "string"
                  },
                  {
                    "const": "watchdog",
                    "type": "string"
                  }
                ]
              }
            }
          }
        },
        "watchdogTicks": {
          "type": "array",
          "items": {
            "minimum": 0,
            "type": "number"
          }
        },
        "phases": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": ["id", "phase", "start"],
            "properties": {
              "id": {
                "minimum": 0,
                "type": "integer"
              },
              "phase": {
                "minLength": 1,
                "type": "string"
              },
              "start": {
                "additionalProperties": false,
                "type": "object",
                "required": ["clock", "t"],
                "properties": {
                  "clock": {
                    "const": "reporter",
                    "type": "string"
                  },
                  "t": {
                    "minimum": 0,
                    "type": "number"
                  }
                }
              },
              "end": {
                "additionalProperties": false,
                "type": "object",
                "required": ["clock", "t"],
                "properties": {
                  "clock": {
                    "const": "reporter",
                    "type": "string"
                  },
                  "t": {
                    "minimum": 0,
                    "type": "number"
                  }
                }
              }
            }
          }
        },
        "ready": {
          "minimum": 0,
          "type": "number"
        },
        "downloads": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "phase",
              "totalTransferBytes",
              "totalDecodedBytes",
              "byCategory",
              "unknownSizeCount",
              "resources"
            ],
            "properties": {
              "phase": {
                "anyOf": [
                  {
                    "const": "load",
                    "type": "string"
                  },
                  {
                    "const": "post-load",
                    "type": "string"
                  }
                ]
              },
              "totalTransferBytes": {
                "minimum": 0,
                "type": "number"
              },
              "totalDecodedBytes": {
                "minimum": 0,
                "type": "number"
              },
              "byCategory": {
                "additionalProperties": false,
                "type": "object",
                "required": ["script", "wasm", "model", "texture", "document", "other"],
                "properties": {
                  "script": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "wasm": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "model": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "texture": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "document": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "other": {
                    "minimum": 0,
                    "type": "number"
                  }
                }
              },
              "unknownSizeCount": {
                "minimum": 0,
                "type": "integer"
              },
              "resources": {
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "url",
                    "category",
                    "initiatorType",
                    "startTime",
                    "responseStart",
                    "responseEnd",
                    "transferSize",
                    "encodedBodySize",
                    "decodedBodySize",
                    "sizeKnown"
                  ],
                  "properties": {
                    "url": {
                      "type": "string"
                    },
                    "category": {
                      "anyOf": [
                        {
                          "const": "script",
                          "type": "string"
                        },
                        {
                          "const": "wasm",
                          "type": "string"
                        },
                        {
                          "const": "model",
                          "type": "string"
                        },
                        {
                          "const": "texture",
                          "type": "string"
                        },
                        {
                          "const": "document",
                          "type": "string"
                        },
                        {
                          "const": "other",
                          "type": "string"
                        }
                      ]
                    },
                    "initiatorType": {
                      "type": "string"
                    },
                    "startTime": {
                      "minimum": 0,
                      "type": "number"
                    },
                    "responseStart": {
                      "minimum": 0,
                      "type": "number"
                    },
                    "responseEnd": {
                      "minimum": 0,
                      "type": "number"
                    },
                    "transferSize": {
                      "minimum": 0,
                      "type": "number"
                    },
                    "encodedBodySize": {
                      "minimum": 0,
                      "type": "number"
                    },
                    "decodedBodySize": {
                      "minimum": 0,
                      "type": "number"
                    },
                    "sizeKnown": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          }
        },
        "environment": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "userAgent": {
              "type": "string"
            },
            "gpuAdapter": {
              "additionalProperties": false,
              "type": "object",
              "properties": {
                "vendor": {
                  "type": "string"
                },
                "architecture": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                }
              }
            },
            "api": {
              "anyOf": [
                {
                  "const": "webgpu",
                  "type": "string"
                },
                {
                  "const": "webgl2",
                  "type": "string"
                },
                {
                  "const": "other",
                  "type": "string"
                }
              ]
            },
            "gpuTimestampsAvailable": {
              "type": "boolean"
            },
            "crossOriginIsolated": {
              "type": "boolean"
            },
            "devicePixelRatio": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "canvasSize": {
              "additionalProperties": false,
              "type": "object",
              "required": ["width", "height"],
              "properties": {
                "width": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "height": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                }
              }
            },
            "chromeFlags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "host": {
              "additionalProperties": false,
              "type": "object",
              "required": ["os", "cpu"],
              "properties": {
                "os": {
                  "type": "string"
                },
                "cpu": {
                  "type": "string"
                },
                "machineId": {
                  "type": "string"
                }
              }
            },
            "gitCommit": {
              "type": "string"
            }
          }
        },
        "convergence": {
          "additionalProperties": false,
          "type": "object",
          "required": ["width", "height", "interval", "targetPsnr", "samples"],
          "properties": {
            "width": {
              "minimum": 1,
              "type": "integer"
            },
            "height": {
              "minimum": 1,
              "type": "integer"
            },
            "interval": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "targetPsnr": {
              "minimum": 0,
              "type": "number"
            },
            "samples": {
              "type": "array",
              "items": {
                "additionalProperties": false,
                "type": "object",
                "required": ["at", "frame", "mse", "psnr"],
                "properties": {
                  "at": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "frame": {
                    "minimum": 0,
                    "type": "integer"
                  },
                  "mse": {
                    "minimum": 0,
                    "type": "number"
                  },
                  "psnr": {
                    "anyOf": [
                      {
                        "minimum": 0,
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            "reference": {
              "minLength": 1,
              "type": "string"
            },
            "diff": {
              "minLength": 1,
              "type": "string"
            },
            "timeToTarget": {
              "minimum": 0,
              "type": "number"
            },
            "framesToTarget": {
              "minimum": 0,
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
