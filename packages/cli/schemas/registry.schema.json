{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "home": {
      "default": {},
      "type": "object",
      "properties": {
        "hero": {
          "type": "object",
          "properties": {
            "scene": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "renderer": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "output": {
              "default": "beauty",
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            }
          },
          "required": ["scene", "renderer"]
        }
      }
    },
    "renderServer": {
      "type": "object",
      "properties": {
        "developmentUrl": {
          "type": "string",
          "format": "uri"
        },
        "deployedUrl": {
          "type": "string",
          "format": "uri"
        },
        "entry": {
          "default": "performance.html",
          "type": "string"
        }
      },
      "required": ["developmentUrl"]
    },
    "renderers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "legacyIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            }
          },
          "kind": {
            "default": "browser",
            "type": "string",
            "enum": ["browser", "external"]
          },
          "reference": {
            "default": false,
            "type": "boolean"
          },
          "enabled": {
            "default": true,
            "type": "boolean"
          },
          "params": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": ["id", "name"]
      }
    },
    "scenes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string"
          },
          "params": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "fidelity": {
            "default": {
              "width": 640,
              "height": 480,
              "frames": 64
            },
            "type": "object",
            "properties": {
              "width": {
                "default": 640,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "default": 480,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "frames": {
                "default": 64,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "required": ["id", "name"]
      }
    },
    "performance": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "defaults": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "renderer": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "scene": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "durationMs": {
                  "default": 10000,
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "params": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                },
                "reference": {
                  "type": "object",
                  "properties": {
                    "image": {
                      "type": "string"
                    },
                    "targetPsnr": {
                      "type": "number"
                    },
                    "intervalMs": {
                      "type": "number"
                    }
                  },
                  "required": ["image"]
                }
              },
              "required": ["renderer", "scene"]
            }
          }
        },
        "required": ["entries"]
      }
    }
  },
  "required": ["schemaVersion", "title", "renderServer", "renderers", "scenes"],
  "$id": "https://unpkg.com/fidelity-kit/schemas/registry.schema.json",
  "title": "Unified fidelity, performance, and live rendering suite"
}
