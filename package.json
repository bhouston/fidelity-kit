{
  "name": "fidelity-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable toolkit for renderer fidelity suites: folder contract, delta/metrics CLI, and viewer.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "tsc -b && pnpm --filter @fidelity-kit/viewer build",
    "tsc": "tsc -b",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "vitest run",
    "cli": "node packages/cli/dist/bin.js",
    "viewer": "pnpm --filter @fidelity-kit/viewer dev",
    "test:coverage": "vitest run --coverage",
    "release": "semantic-release",
    "release:check": "node --test scripts/release.test.mjs"
  },
  "devDependencies": {
    "@anolilab/semantic-release-pnpm": "^8.1.25",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^25.6.0",
    "@types/yargs": "^17.0.35",
    "@vitest/coverage-v8": "^5.0.2",
    "conventional-changelog-conventionalcommits": "^10.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,mdx,css,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.27.0"
}
